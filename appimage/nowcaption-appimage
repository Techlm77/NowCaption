"""Starts NowCaption inside the AppImage (run by AppRun with the bundled Python)."""
import os
import sys

# AppRun preloaded gtk4-layer-shell: launch.py must not re-exec with LD_PRELOAD, and it takes
# gtk4-layer-shell out of LD_PRELOAD again (NOWCAPTION_HOST_LD_PRELOAD), so programs started
# from NowCaption (a browser opened from About) do not load it too.
os.environ['NOWCAPTION_REEXEC'] = '1'

from nowcaption.launch import main  # noqa: E402

sys.exit(main())
