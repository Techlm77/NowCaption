#!/bin/sh
# NowCaption AppImage entry point. Bundled libraries find each other through their RUNPATH,
# so nothing here changes how programs started from NowCaption load their own.
HERE=$(dirname "$(readlink -f "$0")")
cache=${XDG_CACHE_HOME:-$HOME/.cache}/nowcaption
mkdir -p "$cache"

export NOWCAPTION_MODELS="$HERE/usr/share/nowcaption/models"
export GI_TYPELIB_PATH="$HERE/usr/lib/girepository-1.0"
export GIO_MODULE_DIR="$HERE/usr/lib/gio/modules"
export GST_PLUGIN_SYSTEM_PATH_1_0="$HERE/usr/lib/gstreamer-1.0" GST_PLUGIN_PATH_1_0=
export GST_REGISTRY_1_0="$cache/gstreamer-appimage-$(uname -m).bin" GST_REGISTRY_FORK=no
# Last, so the system's own icons, settings schemas and MIME types come first where it has them.
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:$HERE/usr/share"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
# The SVG icon loader's path depends on where the AppImage is mounted.
sed "s|@APPDIR@|$HERE|g" "$HERE/usr/lib/gdk-pixbuf-2.0/loaders.cache.in" > "$cache/pixbuf-loaders.cache" &&
    export GDK_PIXBUF_MODULE_FILE="$cache/pixbuf-loaders.cache"
# glibc: the system's, where it is as new as the one NowCaption was built with; otherwise the
# bundled one, by starting Python through the bundled loader. Its library path then applies to
# NowCaption alone, not to programs it starts.
C="$HERE/usr/lib/compat"
system=$(getconf GNU_LIBC_VERSION 2>/dev/null | cut -d' ' -f2)
built=$(cat "$C/GLIBC_VERSION")
if [ -n "$system" ] && [ "$(printf '%s\n%s\n' "$system" "$built" | sort -V | head -n1)" = "$built" ]; then
    set -- "$HERE/usr/bin/python3" "$HERE/usr/bin/nowcaption-appimage" "$@"
    preload=
else
    loader=$(ls "$C"/ld-linux*.so.* | head -n1)
    export PYTHONHOME="$HERE/usr"  # the running program is the loader, so Python cannot find its home
    set -- "$loader" --library-path "$C" --argv0 "$HERE/usr/bin/python3" \
        "$HERE/usr/bin/python3" "$HERE/usr/bin/nowcaption-appimage" "$@"
    preload=bundled
fi
# Without the system's GLES library, GTK's GL renderer aborts in libepoxy: draw without GL.
has_lib() {
    for d in "/usr/lib/$(uname -m)-linux-gnu" /usr/lib64 /usr/lib "/lib/$(uname -m)-linux-gnu"; do
        [ -e "$d/$1" ] && return 0
    done
    /sbin/ldconfig -p 2>/dev/null | grep -q "$1"
}
has_lib libGLESv2.so.2 || export GSK_RENDERER="${GSK_RENDERER:-cairo}"
# gtk4-layer-shell must load before libwayland-client. In the environment (with the system's
# glibc), nowcaption-appimage takes it out of LD_PRELOAD again once Python has started; the
# bundled loader takes it as an option instead, so programs NowCaption starts never see it.
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    if [ "$preload" = bundled ]; then
        loader=$1; shift
        set -- "$loader" --preload "$HERE/usr/lib/libgtk4-layer-shell.so.0" "$@"
    else
        export NOWCAPTION_HOST_LD_PRELOAD="${LD_PRELOAD:-}"
        export LD_PRELOAD="$HERE/usr/lib/libgtk4-layer-shell.so.0${LD_PRELOAD:+ $LD_PRELOAD}"
    fi
fi
exec "$@"
